# Copy to .env before starting. Docker Compose reads this file automatically.
VIDEO_PROCESSOR_PORT=8899
VIDEO_PROCESSOR_BIND_IP=0.0.0.0
TZ=Asia/Shanghai
# Set both to the full Git commit ID for production builds.
VIDEO_PROCESSOR_IMAGE_TAG=local
VIDEO_PROCESSOR_REVISION=unknown

# auto: prefer NVENC when a real test encode succeeds; otherwise CPU.
# nvidia: require NVENC; cpu: always use CPU.
VIDEO_PROCESSOR_ENCODER_DEVICE=auto
# GPU access requires compose.nvidia.yaml. GPU_DEVICE_ID is the host GPU index.
VIDEO_PROCESSOR_GPU_DEVICE_ID=0
# Safety ceiling; actual concurrency grows automatically toward 80% load.
VIDEO_PROCESSOR_GPU_MAX_CONCURRENT=8
VIDEO_PROCESSOR_GPU_CPU_THREADS=4

VIDEO_PROCESSOR_FILE_RETENTION_DAYS=14
VIDEO_PROCESSOR_RECORD_RETENTION_DAYS=90
VIDEO_PROCESSOR_MAX_UPLOAD_MB=8192
# Free space inside Docker's data disk, in GB.
VIDEO_PROCESSOR_MIN_FREE_GB=20
VIDEO_PROCESSOR_ARCHIVE_RETENTION_HOURS=24
VIDEO_PROCESSOR_UPLOAD_SESSION_RETENTION_HOURS=24

VIDEO_PROCESSOR_H264_PRESET=veryfast
VIDEO_PROCESSOR_H265_PRESET=fast
VIDEO_PROCESSOR_MKV_PRESET=veryfast

# compose.production.yaml requires a nonempty login password and release tag.
# Keep secrets in .env only; do not copy this file over an existing .env.
VIDEO_PROCESSOR_AUTH_USER=admin
VIDEO_PROCESSOR_AUTH_PASSWORD=
VIDEO_PROCESSOR_WECHAT_WEBHOOK=
VIDEO_PROCESSOR_PUBLIC_URL=
